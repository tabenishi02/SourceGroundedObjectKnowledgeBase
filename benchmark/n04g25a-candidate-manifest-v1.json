  "class_definitions": {
    "atomicity": {
      "ATOMIC": "The text contains at most one material proposition independently assessable under one grounding policy.",
      "NON_ATOMIC": "The text combines two or more material propositions whose grounding verdicts can differ, or mixes grounding policies.",
      "AMBIGUOUS": "The boundary between one and multiple material propositions is genuinely unresolved from this text."
    },
    "content_type": {
      "SOURCE_FACT_CONTENT": "The text asserts factual content about the source world, regardless of whether it is true or supported.",
      "INTERPRETATION_CONTENT": "The text states an inferential, comparative or evaluative conclusion without restating factual premises.",
      "CREATIVE_CONTENT": "The text explicitly proposes newly invented fictional material rather than asserting source-world knowledge.",
      "CONTEXT_LIMIT_CONTENT": "The text states only what the supplied context or evidence does not establish or make available.",
      "MIXED_CONTENT": "The text combines material from two or more of factual assertion, interpretation, invention or context availability.",
      "AMBIGUOUS": "The semantic content type cannot be determined safely from the text alone."
    }

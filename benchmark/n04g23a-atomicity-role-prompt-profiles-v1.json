    {
      "profile_id": "clarified-joint-v1",
      "mode": "joint",
      "status": "ready",
      "system_prompt": "You are a bounded SGOKB classifier. Evaluate only (1) atomicity and (2) content-first semantic-role validity. Do not judge factual truth, source support, entailment, retrieval quality, or writing quality. Atomicity: ATOMIC means the text contains at most one independently judgeable material proposition under one grounding policy. NON_ATOMIC means two or more material propositions could receive different grounding verdicts or require different grounding policies. If genuinely ambiguous, use INDETERMINATE. Role boundary: classify content semantics before trusting the declared label. source_fact is a proposition about a source Object, Concept, Work, Character, relationship, event, property, capability, definition, etc.; it may still be unsupported or false, which is not a role violation. interpretation is one conclusion derived from separate factual premises and must not embed those premises in the same unit. creative_addition is newly invented content and is valid only for creative purpose in the creative presentation role. A source-world fact does not become creative merely because the task is creative. Declared role or presentation role never overrides content semantics. Return only the requested JSON verdict object.",
      "user_prompt_template": "Text: ${text}\nDeclared semantic_role: ${semantic_role}\nPurpose: ${purpose}\nPresentation role: ${presentation_role}\n\nClassify atomicity and role boundary independently.",
      "response_format": {
        "type": "json_schema",
        "json_schema": {
          "name": "sgokb_atomicity_role_joint",
          "strict": true,
          "schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "atomicity_verdict": {
                "type": "string",
                "enum": [
                  "ATOMIC",
                  "NON_ATOMIC",
                  "INDETERMINATE"
                ]
              },
              "role_boundary_verdict": {
                "type": "string",
                "enum": [
                  "ROLE_VALID",
                  "ROLE_VIOLATION",
                  "INDETERMINATE"
                ]
              }
            },
            "required": [
              "atomicity_verdict",
              "role_boundary_verdict"
            ]
          }
        }
      }
    },

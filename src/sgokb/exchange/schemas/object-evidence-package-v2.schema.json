{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sgokb:schema:object-evidence-package:2.0",
  "title": "SGOKB Object Evidence Package Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","package_id","created_at","extracted_at","target","binding","artifacts","evidence","raw_grounding","selection","materialization","files","warnings","export_preflight","integrity"],
  "properties": {
    "schema_version": {"const": "sgokb.object-evidence-package/2.0"},
    "package_id": {"type":"string","pattern":"^pkg_[0-9a-f-]+$"},
    "created_at": {"type":"string","format":"date-time"},
    "extracted_at": {"type":"string","format":"date-time"},
    "target": {"$ref":"#/$defs/target"},
    "binding": {"$ref":"#/$defs/binding"},
    "artifacts": {"$ref":"#/$defs/artifacts"},
    "evidence": {"$ref":"#/$defs/evidence"},
    "raw_grounding": {"$ref":"#/$defs/raw_grounding"},
    "selection": {"type":"object"},
    "materialization": {"$ref":"#/$defs/materialization"},
    "files": {"type":"array","minItems":3,"items":{"$ref":"#/$defs/file"}},
    "warnings": {"type":"array","items":{"$ref":"#/$defs/warning"}},
    "export_preflight": {"$ref":"#/$defs/export_preflight"},
    "integrity": {"$ref":"#/$defs/integrity"}
  },
  "$defs": {
    "id": {"type":"string","minLength":1},
    "sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "target": {
      "type":"object","additionalProperties":false,
      "required":["object_id","primary_class_id","additional_class_ids","name","aliases"],
      "properties": {
        "object_id":{"$ref":"#/$defs/id"},
        "primary_class_id":{"$ref":"#/$defs/id"},
        "additional_class_ids":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}},
        "name":{"type":"string","minLength":1},
        "aliases":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}
      }
    },
    "binding": {
      "type":"object","additionalProperties":false,
      "required":["base_version_id","expected_result_schema_version","instructions_version","grounding_contract"],
      "properties": {
        "base_version_id":{"type":["string","null"]},
        "expected_result_schema_version":{"const":"sgokb.object-result/2.0"},
        "instructions_version":{"const":"sgokb.object-analysis/2.0"},
        "grounding_contract":{"const":"sgokb.raw-grounding/1.0"}
      }
    },
    "artifacts": {
      "type":"object","additionalProperties":false,
      "required":["instructions_path","result_schema_path","current_object_path"],
      "properties": {
        "instructions_path":{"const":"instructions.md"},
        "result_schema_path":{"const":"schema/object-result-v2.schema.json"},
        "current_object_path":{"type":["string","null"],"enum":["current_object.json",null]}
      }
    },
    "evidence_item": {
      "type":"object","additionalProperties":false,
      "required":["evidence_id","source_id","snapshot_id","normalization_run_id","selected_by","package_roles","retrieval_reasons","related_selected_evidence_ids"],
      "properties": {
        "evidence_id":{"$ref":"#/$defs/id"},
        "source_id":{"$ref":"#/$defs/id"},
        "snapshot_id":{"$ref":"#/$defs/id"},
        "normalization_run_id":{"$ref":"#/$defs/id"},
        "selected_by":{"enum":["protected","source_diversity","relevance_fill"]},
        "package_roles":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["carry_forward","manual_include","retrieved"]}},
        "retrieval_reasons":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
        "related_selected_evidence_ids":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}}
      }
    },
    "evidence": {
      "type":"object","additionalProperties":false,
      "required":["included_source_ids","included_evidence_ids","items"],
      "properties": {
        "included_source_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},
        "included_evidence_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},
        "items":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/evidence_item"}}
      }
    },
    "raw_artifact": {
      "type":"object","additionalProperties":false,
      "required":["raw_artifact_id","source_id","snapshot_id","artifact_kind","package_path","logical_path","media_type","charset","byte_size","sha256"],
      "properties": {
        "raw_artifact_id":{"$ref":"#/$defs/id"},
        "source_id":{"$ref":"#/$defs/id"},
        "snapshot_id":{"$ref":"#/$defs/id"},
        "artifact_kind":{"type":"string","minLength":1},
        "package_path":{"type":"string","pattern":"^raw/artifact_[0-9]{4,}/payload$"},
        "logical_path":{"type":["string","null"]},
        "media_type":{"type":["string","null"]},
        "charset":{"type":["string","null"]},
        "byte_size":{"type":"integer","minimum":0},
        "sha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "evidence_binding": {
      "type":"object","additionalProperties":false,
      "required":["evidence_id","source_id","snapshot_id","normalization_run_id","raw_artifact_ids"],
      "properties": {
        "evidence_id":{"$ref":"#/$defs/id"},
        "source_id":{"$ref":"#/$defs/id"},
        "snapshot_id":{"$ref":"#/$defs/id"},
        "normalization_run_id":{"$ref":"#/$defs/id"},
        "raw_artifact_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}}
      }
    },
    "raw_grounding": {
      "type":"object","additionalProperties":false,
      "required":["resolution_contract","included_raw_artifact_ids","artifacts","evidence_bindings","integrity"],
      "properties": {
        "resolution_contract":{"const":"sgokb.evidence-to-raw/1.0"},
        "included_raw_artifact_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},
        "artifacts":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/raw_artifact"}},
        "evidence_bindings":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/evidence_binding"}},
        "integrity": {
          "type":"object","additionalProperties":false,
          "required":["hash_algorithm","canonicalization","grounding_set_sha256"],
          "properties": {
            "hash_algorithm":{"const":"sha256"},
            "canonicalization":{"const":"sgokb-json-c14n-v1"},
            "grounding_set_sha256":{"$ref":"#/$defs/sha256"}
          }
        }
      }
    },
    "materialization": {
      "type":"object","additionalProperties":false,
      "required":["policy_profile","budget","usage"],
      "properties": {
        "policy_profile":{"type":"string","minLength":1},
        "budget": {
          "type":"object","additionalProperties":false,
          "required":["max_total_raw_bytes","max_single_raw_bytes","max_raw_artifacts"],
          "properties": {
            "max_total_raw_bytes":{"type":"integer","minimum":1},
            "max_single_raw_bytes":{"type":"integer","minimum":1},
            "max_raw_artifacts":{"type":"integer","minimum":1}
          }
        },
        "usage": {
          "type":"object","additionalProperties":false,
          "required":["total_raw_bytes","largest_raw_bytes","raw_artifact_count","selected_evidence_count","source_count"],
          "properties": {
            "total_raw_bytes":{"type":"integer","minimum":0},
            "largest_raw_bytes":{"type":"integer","minimum":0},
            "raw_artifact_count":{"type":"integer","minimum":1},
            "selected_evidence_count":{"type":"integer","minimum":1},
            "source_count":{"type":"integer","minimum":1}
          }
        }
      }
    },
    "file": {
      "type":"object","additionalProperties":false,
      "required":["path","role","media_type","size_bytes","sha256"],
      "properties": {
        "path":{"type":"string","minLength":1},
        "role":{"enum":["instructions","current_object","result_schema","raw_grounding"]},
        "media_type":{"type":"string","minLength":1},
        "size_bytes":{"type":"integer","minimum":0},
        "sha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "warning": {
      "type":"object","additionalProperties":false,
      "required":["code","severity","message"],
      "properties": {
        "code":{"type":"string","minLength":1},
        "severity":{"enum":["info","warning","review_required","blocking"]},
        "message":{"type":"string","minLength":1}
      }
    },
    "export_preflight": {
      "type":"object","additionalProperties":false,
      "required":["disposition","reasons","credential_material_included"],
      "properties": {
        "disposition":{"enum":["allow","review_required","blocked"]},
        "reasons":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
        "credential_material_included":{"const":false}
      }
    },
    "integrity": {
      "type":"object","additionalProperties":false,
      "required":["hash_algorithm","canonicalization","manifest_sha256"],
      "properties": {
        "hash_algorithm":{"const":"sha256"},
        "canonicalization":{"const":"sgokb-json-c14n-v1"},
        "manifest_sha256":{"$ref":"#/$defs/sha256"}
      }
    }
  }
}
